# Copy to .env (docker compose) or backend/.env (running the API directly) and fill in.

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Production uses Neon: DATABASE_URL is the pooled string, DIRECT_URL the direct one (for migrations).
DATABASE_URL=postgresql://icadmin:change-me-locally@localhost:5432/intercontinental_crest
DIRECT_URL=postgresql://icadmin:change-me-locally@localhost:5432/intercontinental_crest
POSTGRES_USER=icadmin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=intercontinental_crest

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random strings. Required in production (the API will not start without JWT_SECRET).
JWT_SECRET=
# Optional; derived from JWT_SECRET when empty.
JWT_REFRESH_SECRET=

# Super admin login. Applied on every start, so changing these changes the admin's email/password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Used in email links (password reset, notifications).
FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed to call the API directly (comma separated). Optional.
CORS_ORIGINS=
# Web app only: where /api/* is proxied (server side). Defaults to the production API in production builds.
BACKEND_URL=http://localhost:4000

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are written to backend/mails/sent_mails.log instead of being sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Intercontinental Crest <no-reply@example.com>"
